{
  "name": "markit-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Markit desktop shell (Electron). Product composition root for the UI track.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/build-main.mjs",
    "dev": "vite",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-markdown": "^6.4.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "codemirror": "^6.0.2",
    "electron": "^44.5.1",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
