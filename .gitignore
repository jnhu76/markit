# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Build output
build/
dist/
target/
out/

# Dependencies / package managers
node_modules/
.bun/
.pnpm-store/

# Logs / temporary files
*.log
*.tmp
*.temp

# Profiling outputs can be huge.
# Keep curated metadata/summaries in git and store large captures externally.
profiles/*
!profiles/.gitkeep

# Raw benchmark output may be machine-specific or large.
results/raw/*
!results/raw/.gitkeep

# Curated frozen-baseline evidence is small and must stay reviewable
# (docs/product/g0-gpui-baseline.md §5). Explicitly re-include it because
# the generic *.log rule above would otherwise ignore the trace files.
!results/evidence/
!results/evidence/g0/*
!results/evidence/g0/*.log
bench/__pycache__/
